[Unit]
Description=SOCKS tunnel to JP relay 2 (backup #1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -D 127.0.0.1:20082 -i /root/.ssh/jp-relay-2.key -o ExitOnForwardFailure=yes -o ConnectTimeout=8 -o ConnectionAttempts=1 -o ServerAliveInterval=10 -o ServerAliveCountMax=2 -o TCPKeepAlive=yes -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR root@141.11.139.81
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
