# Put `underscores_in_headers on;` in the nginx `http` block.
#
# Include or paste this location into the active HTTPS server that fronts
# Sub2API when Codex/OpenAI Responses traffic may enter through either
# `/responses` or `/v1/responses`.

location ~ ^/(v1/)?(messages|responses|chat/completions)(/.*)?$ {
    limit_req zone=sub2api_gateway_api burst=120 nodelay;

    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    proxy_buffering off;
    proxy_request_buffering off;
    gzip off;
    add_header X-Accel-Buffering no always;
}
