  "normalization_policy": "provider-specific-evidence-only",
  "field_semantics": {
    "expected_public_id": "canonical ID emitted to authorized clients; null means hidden/quarantined",
    "accepted_input_canonical_id": "canonical request model after accepting an evidenced input alias",
    "account_catalog_ids": "when present, exact raw IDs from this account's last complete snapshot; if omitted, default to the singleton [raw_id]",
    "requested_input_id": "exact model ID submitted by the client for this case",
    "raw_id": "one exact ID returned by the account catalog, not a display name or billing alias",
    "expected_route_id": "exact raw model ID sent upstream; if non-null it must be present in effective account_catalog_ids (explicit or [raw_id])"
  },
